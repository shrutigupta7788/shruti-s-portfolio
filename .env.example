# EmailJS Configuration
# Create a free account at https://www.emailjs.com/
# 1. Email Services -> Add New Service -> Service ID (e.g. service_xxxxxxx)
# 2. Email Templates -> Create New Template -> Template ID (e.g. template_xxxxxxx)
# 3. Account -> Public Key (e.g. xxxxxxxxxxxxxxxx)

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
